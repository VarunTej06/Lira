{
  "name": "liraspaces-api",
  "version": "0.1.0",
  "private": true,
  "description": "The hosted edition's API: sign-up, log-in and sessions on PostgreSQL.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "migrate": "node dist/db/migrate-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/storage-blob": "12.34.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "argon2": "0.45.2",
    "express": "5.2.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
